# Project URL (defaults to the owner project if unset)
VITE_SUPABASE_URL=https://rhpzvqvkmllbdtkpouwn.supabase.co

# Publishable anon key — set in Cursor Secrets as SUPABASE_ANON_KEY
# or locally as VITE_SUPABASE_ANON_KEY in .env.local (never commit the value).
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=

# LINE Login channel ID (public) — for「用 LINE 綁定」only; not app login.
# Also set on Vercel Production. Callback path: /line-bind-callback
# VITE_LINE_LOGIN_CHANNEL_ID=

# LIFF — prefer one app per page (no double redirect):
# VITE_LIFF_ID_ATTENDANCE=
# VITE_LIFF_ID_LOCATION=
# Optional shared fallback (Endpoint = /liff, paths /attendance|/location):
# VITE_LIFF_ID=
